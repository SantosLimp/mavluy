# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas connection string to connect your live database.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ecommerce_db?retryWrites=true&w=majority
MONGODB_URI=

# JWT_SECRET: Secret key for signing admin and customer authentication tokens.
JWT_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDINARY CONFIGURATION (For direct image uploads & zero-lag performance):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

