# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Secret key for signing admin and customer authentication tokens.
JWT_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDINARY CONFIGURATION (For direct image uploads & zero-lag performance):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# OPTIONAL GOOGLE SHEETS / UNIVERSAL WEBHOOK INTEGRATION
# (Can be set here or dynamically configured per country in the Admin Dashboard Settings)
GOOGLE_SHEETS_WEBHOOK_URL=
